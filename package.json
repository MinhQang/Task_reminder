{
  "name": "task-reminder",
  "version": "1.3.0",
  "description": "Ứng dụng nhắc việc cá nhân cho Windows",
  "author": "Task Reminder",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:ui": "node scripts/ui-test.js",
    "test:browser": "node scripts/browser-test.js",
    "build": "electron-builder --win nsis --x64",
    "build:portable": "electron-builder --win portable --x64",
    "test:features": "node scripts/features-ui-test.js"
  },
  "build": {
    "appId": "local.taskreminder.desktop",
    "productName": "Task Reminder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/assets/icon.ico",
      "target": "nsis",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "artifactName": "Task-Reminder-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "createStartMenuShortcut": true,
      "shortcutName": "Task Reminder"
    }
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.0"
  }
}
