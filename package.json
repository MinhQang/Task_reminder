{
  "name": "task-reminder",
  "version": "2.0.0",
  "description": "Ứng dụng nhắc việc cá nhân cho Windows",
  "author": "Task Reminder",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:ui": "node scripts/ui-test.js",
    "test:browser": "node scripts/browser-test.js",
    "build": "electron-builder --win nsis --x64",
    "build:portable": "electron-builder --win portable --x64",
    "test:features": "node scripts/features-ui-test.js",
    "build:ui": "node scripts/build-ui.cjs",
    "prestart": "npm run build:ui",
    "prebuild": "npm run build:ui",
    "prebuild:portable": "npm run build:ui",
    "pretest:ui": "npm run build:ui",
    "pretest:features": "npm run build:ui",
    "pretest:browser": "npm run build:ui"
  },
  "build": {
    "appId": "local.taskreminder.desktop",
    "productName": "Task Reminder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/ui/liquid-glass.entry.js",
      "package.json"
    ],
    "win": {
      "icon": "src/assets/icon.ico",
      "target": "nsis",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "artifactName": "Task-Reminder-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "createStartMenuShortcut": true,
      "shortcutName": "Task Reminder"
    }
  },
  "devDependencies": {
    "@tomagranate/liquid-glass": "0.0.2",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2",
    "playwright": "^1.65.0"
  }
}
